{
    "css": {
        "parser": {
            "tailwindDirectives": true
        }
    },
    "json": {
        "parser": {
            "allowComments": true,
            "allowTrailingCommas": true
        },
        "formatter": {
            "enabled": true,
            "trailingCommas": "none",
            "indentStyle": "space",
            "indentWidth": 2
        }
    },
    "overrides": [
        {
            "includes": [
                "**/*.astro"
            ],
            "linter": {
                "rules": {
                    "style": {
                        "useConst": "off",
                        "useImportType": "off"
                    },
                    "correctness": {
                        "noUnusedVariables": "warn",
                        "noUnusedImports": "warn"
                    }
                }
            }
        }
    ]
}